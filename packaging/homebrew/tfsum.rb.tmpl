class Tfsum < Formula
  desc "Detailed, color-coded, risk-aware alternative to `terraform plan`"
  homepage "https://github.com/Fanatic-zer0/tfsum"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/Fanatic-zer0/tfsum/releases/download/{{TAG}}/tfsum_{{TAG}}_darwin_arm64.tar.gz"
      sha256 "{{DARWIN_ARM64_SHA}}"
    else
      url "https://github.com/Fanatic-zer0/tfsum/releases/download/{{TAG}}/tfsum_{{TAG}}_darwin_amd64.tar.gz"
      sha256 "{{DARWIN_AMD64_SHA}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/Fanatic-zer0/tfsum/releases/download/{{TAG}}/tfsum_{{TAG}}_linux_arm64.tar.gz"
      sha256 "{{LINUX_ARM64_SHA}}"
    else
      url "https://github.com/Fanatic-zer0/tfsum/releases/download/{{TAG}}/tfsum_{{TAG}}_linux_amd64.tar.gz"
      sha256 "{{LINUX_AMD64_SHA}}"
    end
  end

  def install
    bin.install "tfsum"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tfsum --version")
  end
end
